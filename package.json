{
  "name": "engineering-command-os",
  "version": "1.0.0",
  "description": "Tauri-Based AI-Powered Desktop Engineering Interface",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "backend:python": "cd backend/python && python main.py",
    "backend:node": "cd backend/node && node src/index.js",
    "start:all": "concurrently \"npm run backend:python\" \"npm run backend:node\" \"npm run dev\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "axios": "^1.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.0",
    "zod": "^3.22.0",
    "echarts": "^5.4.0",
    "echarts-for-react": "^3.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "three": "^0.159.0",
    "@react-three/fiber": "^8.15.0",
    "@react-three/drei": "^9.88.0",
    "react-grid-layout": "^1.4.0",
    "@monaco-editor/react": "^4.6.0",
    "react-flow": "^11.10.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.159.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^8.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "@tauri-cli": "^2.0.0",
    "tailwindcss": "^4.0.0"
  }
}
